{
  "schemaName": "sales",
  "dimensionFieldSpecs": [
    { "name": "sale_id", "dataType": "LONG" },
    { "name": "customer_id", "dataType": "LONG" },
    { "name": "product_id", "dataType": "LONG" },
    { "name": "quantity", "dataType": "INT" }
  ],
  "metricFieldSpecs": [
    { "name": "amount", "dataType": "DOUBLE" }
  ],
  "dateTimeFieldSpecs": [
    {
      "name": "sale_timestamp",
      "dataType": "TIMESTAMP",
      "format": "1:MILLISECONDS:EPOCH",
      "granularity": "1:MILLISECONDS"
    }
  ]
}
